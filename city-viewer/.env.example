# Copy this file to .env (same folder) and fill it in. NEVER commit .env.
# Account = the part of your Snowflake URL before .snowflakecomputing.com
SNOWFLAKE_ACCOUNT=abc12345.eu-west-2.aws
# Snowsight -> your profile -> Settings -> Authentication -> Programmatic access tokens -> Generate
SNOWFLAKE_TOKEN=paste-your-token-here
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Optional: which Cortex model writes the report
SNOWFLAKE_MODEL=mistral-large2
